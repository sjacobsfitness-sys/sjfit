# Copy to .env and fill in. NEVER commit .env.

# "sandbox" or "production". Truemed gives you a different API key for each.
TRUEMED_ENV=sandbox
TRUEMED_API_KEY=

# Override only if Truemed's docs/support give you a different base URL.
# TRUEMED_BASE_URL=https://dev-api.truemed.com

# Public URL where this server is reachable (used for success/failure redirects).
PUBLIC_URL=http://localhost:3000
PORT=3000

# Password for the /admin page (username: admin).
ADMIN_PASSWORD=change-me

# Optional: shared secret Truemed sends with webhooks. If set, requests without it are rejected.
# Regardless, every webhook is re-verified by fetching the session from Truemed's API.
TRUEMED_WEBHOOK_SECRET=

# Optional: percent to gross-up prices by so Truemed's fee is wrapped into the client's price (e.g. 5).
TRUEMED_FEE_PERCENT=0
