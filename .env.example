# Copy to .env for local runs. On Render, set these in the service's Environment tab.
# NEVER commit real values.

# --- Truemed ---
# "sandbox" or "production". Key and base URL switch together.
TRUEMED_ENV=sandbox
TRUEMED_API_KEY=
# TRUEMED_BASE_URL=https://dev-api.truemed.com
# Optional: shared secret sent by Truemed with webhooks.
TRUEMED_WEBHOOK_SECRET=
# Optional: % to add to HSA/FSA payments to cover Truemed's fee (sandbox showed ~6.33%: $38 on $600).
TRUEMED_FEE_PERCENT=0

# --- Stripe (test keys first: sk_test_ / pk_test_) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Custom payment method type from Dashboard > Settings > Payments > Custom payment methods.
# With this + the publishable key, the pay page shows Stripe's Payment Element (Card + HSA/FSA).
STRIPE_CPM_TYPE_ID=cpmt_1UL50oLq864JVSey7z5BW3UB

# --- App ---
PUBLIC_URL=http://localhost:3000
PORT=3000
ADMIN_PASSWORD=change-me
BRAND_NAME=Jacobs Fitness
